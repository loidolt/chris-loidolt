# PocketBase Configuration
# For local development: http://127.0.0.1:8090
# For production: your deployed PocketBase URL
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=your_secure_password

# Airtable Configuration (ONLY needed for data migration)
# If you're migrating from Airtable, keep these to run: npm run export:airtable
# AIRTABLE_API_KEY=your_airtable_api_key
# AIRTABLE_POSTS_BASEID=your_base_id
# AIRTABLE_POSTS_TABLENAME=Projects
# AIRTABLE_QUALIFICATIONS_TABLENAME=Qualifications
# AIRTABLE_WEBSITES_TABLENAME=Websites
# AIRTABLE_SERVICES_TABLENAME=Services
# AIRTABLE_LOCATIONS_TABLENAME=Locations

# Contact Form Email (Resend - https://resend.com)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL_TO=your-email@example.com
CONTACT_EMAIL_FROM=noreply@chrisloidolt.com

# Optional: GitHub for additional project data
GITHUB_TOKEN=
GITHUB_USERNAME=
