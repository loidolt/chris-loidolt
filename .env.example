# =============================================================================
# Core Configuration
# =============================================================================

# PocketBase Configuration
# For local development: http://127.0.0.1:8090
# For production: your deployed PocketBase URL
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=your_secure_password

# Multi-Tenant Configuration
# Base domain for subdomain routing (e.g., loidolt.space)
# Subdomains will be: chris.loidolt.space, julia.loidolt.space, etc.
BASE_DOMAIN=loidolt.space

# =============================================================================
# Performance & Caching
# =============================================================================

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Logging Configuration
# Options: debug, info, warn, error (default: info)
# Set to 'debug' to enable detailed logging
LOG_LEVEL=info

# =============================================================================
# Data Migration (Optional)
# =============================================================================

# Airtable Configuration (ONLY needed for data migration)
# If you're migrating from Airtable, keep these to run: npm run export:airtable
# AIRTABLE_API_KEY=your_airtable_api_key
# AIRTABLE_POSTS_BASEID=your_base_id
# AIRTABLE_POSTS_TABLENAME=Projects
# AIRTABLE_QUALIFICATIONS_TABLENAME=Qualifications
# AIRTABLE_WEBSITES_TABLENAME=Websites
# AIRTABLE_SERVICES_TABLENAME=Services
# AIRTABLE_LOCATIONS_TABLENAME=Locations

# =============================================================================
# Contact Form
# =============================================================================

# Mailgun Configuration (https://www.mailgun.com)
# Get your API key from: https://app.mailgun.com/app/account/security/api_keys
# Domain: Your verified Mailgun domain (e.g., mg.yourdomain.com)
# Region: 'us' for US or 'eu' for EU (default: us)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_REGION=us
CONTACT_EMAIL_TO=your-email@example.com
CONTACT_EMAIL_FROM=noreply@mg.yourdomain.com

# =============================================================================
# External Integrations (Optional)
# =============================================================================

# Optional: GitHub for additional project data
GITHUB_TOKEN=
GITHUB_USERNAME=
