# Docker Compose Environment Variables
# Copy this to .env.local and fill in your values

# PocketBase Admin (required for first-time setup)
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=changeme123

# Contact Form (optional)
RESEND_API_KEY=
CONTACT_EMAIL_TO=your-email@example.com
CONTACT_EMAIL_FROM=noreply@chrisloidolt.com

# Development Options
NEXT_PUBLIC_USE_MOCK_LOCATIONS=false

# Note: POCKETBASE_URL is set automatically in docker-compose.yml
# For native development (without Docker), use: POCKETBASE_URL=http://127.0.0.1:8090
