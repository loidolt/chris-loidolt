{
  "name": "chris-loidolt",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3050",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pwa:icons": "node scripts/create-pwa-icons.mjs",
    "export:airtable": "tsx scripts/export-airtable.ts",
    "export:schema": "tsx scripts/export-schema.ts",
    "import:pocketbase": "tsx scripts/import-pocketbase.ts",
    "import:csv": "tsx scripts/import-csv-to-pocketbase.ts",
    "import:schema": "tsx scripts/import-schema.ts",
    "cleanup:data": "tsx scripts/cleanup-pocketbase.ts",
    "relink:person": "tsx scripts/relink-person.ts",
    "seed:locations": "tsx scripts/seed-locations.ts",
    "migrate:multitenant": "tsx scripts/migrate-multitenant.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:rebuild": "docker compose up -d --build",
    "docker:clean": "docker compose down -v && rm -rf pb_data",
    "docker:pocketbase": "docker compose exec pocketbase sh",
    "pocketbase:init": "sh scripts/init-pocketbase.sh"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
