{
  "name": "chris-loidolt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "wrangler pages dev --compatibility-date=2024-01-01 --live-reload -- npm run dev:react-router",
    "dev:react-router": "react-router dev --manual",
    "start": "wrangler pages dev ./build/client",
    "deploy": "npm run build && wrangler pages deploy ./build/client",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "@react-router/cloudflare": "^7.9.4",
    "@react-router/node": "^7.9.2",
    "@react-router/serve": "^7.9.2",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "airtable": "^0.12.2",
    "fuse.js": "^7.1.0",
    "isbot": "^5.1.31",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.2",
    "three": "^0.180.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.2",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.44.0"
  }
}
