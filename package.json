    "@lucide/svelte": "^0.544.0",
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22",
    "@types/three": "^0.180.0",
    "@vite-pwa/sveltekit": "^1.0.1",
