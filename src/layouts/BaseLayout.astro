---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Chris Loidolt - Design & Engineering Portfolio',
  description = 'Portfolio of Chris Loidolt showcasing design and engineering projects in 3D printing, woodworking, and software development.',
} = Astro.props;

const navItems = [
  { href: '/', label: 'home' },
  { href: '/projects', label: 'projects' },
  { href: '/about', label: 'about' },
  { href: '/contact', label: 'contact' },
];

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c1a16" />

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Chris Loidolt Portfolio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <div class="min-h-screen flex flex-col" style="background-color: var(--bg-primary);">
      <!-- Terminal Header with Tabs -->
      <header class="relative" style="z-index: 10;">
        <!-- Tab Navigation -->
        <nav class="flex items-center" style="border-bottom: 1px solid var(--border-color);">
          {navItems.map((item, index) => (
            <a
              href={item.href}
              class="px-6 py-3 text-sm relative transition-all hover:opacity-70"
              style={`
                color: var(--text-primary);
                border-right: ${index < navItems.length - 1 ? '1px solid var(--border-color)' : 'none'};
                background-color: ${Astro.url.pathname === item.href || (item.href === '/projects' && Astro.url.pathname.startsWith('/projects')) ? 'var(--bg-primary)' : 'var(--bg-surface)'};
              `}
            >
              {item.label}
            </a>
          ))}
          <div class="ml-auto px-4">
            <ThemeToggle client:load />
          </div>
        </nav>
      </header>

      <!-- Main Content -->
      <main class="flex-1 container mx-auto px-6 py-12 max-w-6xl">
        <slot />
      </main>

      <!-- Terminal Footer -->
      <footer class="relative" style="z-index: 10; border-top: 1px solid var(--border-color); background-color: var(--bg-surface);">
        <div class="container mx-auto px-6 py-6 max-w-6xl">
          <div class="flex items-center justify-between text-xs" style="color: var(--text-muted);">
            <div class="flex items-center gap-6">
              <span>© {currentYear} Chris Loidolt</span>
              <a
                href="https://github.com/chris-loidolt"
                target="_blank"
                rel="noopener noreferrer"
                style="color: var(--link-color);"
                class="hover:opacity-70 transition-opacity"
              >
                github
              </a>
            </div>
            <div style="color: var(--text-muted);">
              <span class="opacity-50">~/portfolio</span>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
