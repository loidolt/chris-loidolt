---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle';
import MapViewer from '@components/MapViewer';
import { getAllLocations } from '@lib/airtable';

// Fetch locations at build time
let locations = [];
try {
  locations = await getAllLocations();
} catch (error) {
  console.error('Error loading locations:', error);
}

const title = 'GIS Map - Chris Loidolt';
const description = 'Interactive topographic map showing points of interest and locations.';

const navItems = [
  { href: '/', label: 'home' },
  { href: '/projects', label: 'projects' },
  { href: '/gis', label: 'gis' },
  { href: '/about', label: 'about' },
  { href: '/contact', label: 'contact' },
];

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c1a16" />

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Chris Loidolt Portfolio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <div class="min-h-screen flex flex-col" style="background-color: var(--bg-primary);">
      <!-- Terminal Header with Tabs -->
      <header class="relative" style="z-index: 10;">
        <!-- Tab Navigation -->
        <nav class="flex items-center" style="border-bottom: 1px solid var(--border-color);">
          {navItems.map((item, index) => (
            <a
              href={item.href}
              class="px-6 py-3 text-sm relative transition-all hover:opacity-70"
              style={`
                color: var(--text-primary);
                border-right: ${index < navItems.length - 1 ? '1px solid var(--border-color)' : 'none'};
                background-color: ${item.href === '/gis' ? 'var(--bg-primary)' : 'var(--bg-surface)'};
              `}
            >
              {item.label}
            </a>
          ))}
          <div class="ml-auto px-4">
            <ThemeToggle client:load />
          </div>
        </nav>
      </header>

      <!-- Full-height Main Content (no padding) -->
      <main class="flex-1" style="position: relative; overflow: hidden;">
        <MapViewer locations={locations} client:only="react" />
      </main>
    </div>
  </body>
</html>
