---
import BaseLayout from '@layouts/BaseLayout.astro';
import TerminalWelcome from '@components/TerminalWelcome';
import ProjectNodeGraph from '@components/ProjectNodeGraph';
import { getAllProjects } from '@lib/airtable';

const quickLinks = [
  { label: 'View all projects', link: '/projects' },
  { label: 'Learn more about me', link: '/about' },
  { label: 'Get in touch', link: '/contact' },
];

// Fetch projects for the node graph
const allProjects = await getAllProjects();
const stats = [
  { label: 'Projects', value: `${allProjects.length}`, href: '/projects' },
  { label: 'Categories', value: '8', href: '/projects' },
  { label: '3D Models', value: '30+', href: '/projects' },
];

// Prepare simplified project data for the graph (only what we need)
const projectsForGraph = allProjects.map(p => ({
  id: p.id,
  title: p.title,
  slug: p.slug,
  categories: p.categories || [],
  tags: p.tags || []
}));
---

<BaseLayout
  title="Chris Loidolt - Design & Engineering Portfolio"
  description="Portfolio of Chris Loidolt showcasing design and engineering projects in 3D printing, woodworking, and software development."
>
  <!-- Background Graph - full viewport, positioned fixed -->
  <div class="fixed inset-0 opacity-45 pointer-events-none" style="z-index: 0;">
    <ProjectNodeGraph projects={projectsForGraph} client:load />
  </div>

  <!-- Foreground Content - relative positioning with proper spacing -->
  <div class="relative" style="z-index: 1;">
      <!-- Terminal Welcome with typing animation -->
      <TerminalWelcome client:load />

      <!-- Quick Links Section -->
      <div class="py-8" style="border-top: 1px solid var(--border-color);">
        <div class="mb-6 text-sm" style="color: var(--accent-secondary);">Quick Links</div>
        <div class="space-y-3">
          {quickLinks.map((item) => (
            <a
              href={item.link}
              class="block text-sm transition-opacity hover:opacity-70"
              style="color: var(--link-color);"
            >
              [{item.label} →]
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Stats -->
      <div class="py-8" style="border-top: 1px solid var(--border-color);">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {stats.map((stat) => (
            <a href={stat.href} class="group">
              <div class="text-xs mb-2 transition-opacity" style="color: var(--link-color);">
                [{stat.label.toLowerCase()}]
              </div>
              <div class="text-4xl font-medium transition-opacity group-hover:opacity-70" style="color: var(--accent-primary);">
                {stat.value}
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
</BaseLayout>
