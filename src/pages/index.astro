---
import BaseLayout from '@layouts/BaseLayout.astro';
import TerminalWelcome from '@components/TerminalWelcome';

const commands = [
  { cmd: 'ls /projects', desc: 'View all projects', link: '/projects' },
  { cmd: 'cat about.txt', desc: 'Learn more', link: '/about' },
  { cmd: 'mail', desc: 'Get in touch', link: '/contact' },
];

const stats = [
  { label: 'Projects', value: '50+', href: '/projects' },
  { label: 'Categories', value: '8', href: '/projects' },
  { label: '3D Models', value: '30+', href: '/projects' },
];
---

<BaseLayout
  title="Chris Loidolt - Design & Engineering Portfolio"
  description="Portfolio of Chris Loidolt showcasing design and engineering projects in 3D printing, woodworking, and software development."
>
  <div>
    <!-- Terminal Welcome with typing animation -->
    <TerminalWelcome client:load />

    <!-- Terminal Prompt / Help Section -->
    <div class="py-8" style="border-top: 1px solid var(--border-color);">
      <div class="mb-6 text-sm" style="color: var(--accent-secondary);">$ help</div>
      <div class="space-y-3">
        {commands.map((item) => (
          <a
            href={item.link}
            class="flex items-start gap-6 text-sm transition-opacity hover:opacity-70 group"
          >
            <code class="min-w-[140px]" style="color: var(--text-primary);">
              {item.cmd}
            </code>
            <span style="color: var(--text-muted);">{item.desc}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="py-8" style="border-top: 1px solid var(--border-color);">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {stats.map((stat) => (
          <a href={stat.href} class="group">
            <div class="text-xs mb-2 transition-opacity" style="color: var(--link-color);">
              [{stat.label.toLowerCase()}]
            </div>
            <div class="text-4xl font-medium transition-opacity group-hover:opacity-70" style="color: var(--accent-primary);">
              {stat.value}
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
